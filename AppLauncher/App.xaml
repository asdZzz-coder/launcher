<Application x:Class="AppLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppLauncher"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 第一個是顏色表，啟動時由 ThemeManager 依系統設定換成 Light 或 Dark -->
                <ResourceDictionary Source="/Themes/Light.xaml" />
                <ResourceDictionary Source="/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
