<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 淺色模式的顏色。Dark.xaml 要有同樣的 key。 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#CDD3DD" />
    <SolidColorBrush x:Key="LineBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F3F7" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#101828" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#667085" />
    <SolidColorBrush x:Key="MutedBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF3FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UpdateBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="UpdateHoverBrush" Color="#D97706" />
    <SolidColorBrush x:Key="UpdateSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="UpdateTextBrush" Color="#92400E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="NeutralTextBrush" Color="#475467" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4CAD4" />
    <Color x:Key="ShadowColor">#101828</Color>
    <system:Double x:Key="ShadowOpacity" xmlns:system="clr-namespace:System;assembly=mscorlib">0.07</system:Double>
</ResourceDictionary>
