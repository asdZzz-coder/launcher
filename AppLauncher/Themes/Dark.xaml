<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色模式的顏色。Light.xaml 要有同樣的 key。 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#111318" />
    <SolidColorBrush x:Key="CardBrush" Color="#1B1E25" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3A4150" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A2F3A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#252A33" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2E3440" />
    <SolidColorBrush x:Key="InputBrush" Color="#15181E" />
    <SolidColorBrush x:Key="PopupBrush" Color="#21252D" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#A3ABBA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2742" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UpdateBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="UpdateHoverBrush" Color="#D97706" />
    <SolidColorBrush x:Key="UpdateSoftBrush" Color="#3A2A0C" />
    <SolidColorBrush x:Key="UpdateTextBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2E1C" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#86EFAC" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#252A33" />
    <SolidColorBrush x:Key="NeutralTextBrush" Color="#C3C9D4" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1717" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3F4654" />
    <Color x:Key="ShadowColor">#000000</Color>
    <system:Double x:Key="ShadowOpacity" xmlns:system="clr-namespace:System;assembly=mscorlib">0.35</system:Double>
</ResourceDictionary>
