<Window x:Class="AppLauncher.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppLauncher.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FolderPickerViewModel}"
        Title="選擇資料夾" Icon="Assets/app.ico"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 資料夾清單的一列：整列都可以點，選取時強調色外框 -->
        <Style x:Key="FolderItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="10" BorderThickness="1.5" Padding="14,10,8,10"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="選擇要讀取的資料夾。可以是電腦上的資料夾，也可以是 NAS 或網路磁碟。"
                   Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />

        <!-- 最近開過的資料夾 -->
        <ListBox x:Name="FolderList" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                 ItemContainerStyle="{StaticResource FolderItem}" MaxHeight="340"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="FolderList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FolderChoice}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 資料夾 / NAS 圖示 -->
                        <TextBlock x:Name="KindGlyph" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                            <TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="從清單移除（不會刪除資料夾）"
                                Width="30" Height="30" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                            <Setter TargetName="KindGlyph" Property="Text" Value="&#xE8CE;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Missing">
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 還沒開過任何資料夾 -->
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Padding="16,18"
                Background="{DynamicResource CardBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="還沒有開過資料夾，按左下角的「選擇資料夾…」挑一個。" Foreground="{DynamicResource SubTextBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
        </Border>

        <Grid Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}" Click="Browse_Click" HorizontalAlignment="Left"
                    Padding="10,0" Margin="-10,0,0,0" ToolTip="選擇電腦、NAS 或網路磁碟上的資料夾">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="選擇資料夾…" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Click="Open_Click" IsDefault="True" IsEnabled="{Binding CanOpen}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="{Binding ConfirmText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
