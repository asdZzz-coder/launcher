<Window x:Class="AppLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppLauncher.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="APP 啟動器" Icon="Assets/app.ico"
        Width="960" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="AppCard" DataType="{x:Type vm:AppItemViewModel}">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,14,0" ToolTip="勾選後可以批次下載或刪除" />

                    <!-- 圖示：沒下載前顯示名稱第一個字；有新版時右上角加橘色箭頭 -->
                    <Grid Grid.Column="1" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="#E0E7FF"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="#3730A3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource UpdateBrush}"
                                BorderBrush="White" BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="有新版本可以更新">
                            <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}" Background="{StaticResource UpdateSoftBrush}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{StaticResource UpdateTextBrush}" VerticalAlignment="Center" Margin="0,1,4,0" />
                                    <TextBlock Foreground="{StaticResource UpdateTextBrush}" FontSize="12" FontWeight="SemiBold">
                                        <Run Text="可更新" /> <Run Text="{Binding Latest.Tag, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}"
                                    Visibility="{Binding IsLatestInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" Margin="0,1,4,0" />
                                    <TextBlock Text="已是最新版" Foreground="{StaticResource SuccessTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                  DisplayMemberPath="Label" Width="150" Height="34" VerticalContentAlignment="Center"
                                  Padding="8,0" Margin="0,0,8,0" ToolTip="選擇要開啟的版本，舊版也可以開"
                                  IsEnabled="{Binding IsIdle}"
                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" />
                                <TextBlock Text="開啟" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource UpdateBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource UpdateBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasUpdate}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource UpdateHoverBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                                <TextBlock Text="{Binding DownloadText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" />
                                <TextBlock Text="取消" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="更多" Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             FontFamily="{StaticResource UiFont}">
                                    <MenuItem Header="開啟此版本的資料夾" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="在 GitHub 查看版本說明" Command="{Binding OpenReleasePageCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding DeleteVersionText}" Command="{Binding DeleteSelectedVersionCommand}" />
                                    <MenuItem Header="刪除所有版本" Command="{Binding DeleteAllCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 下載進度與訊息 -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}">
                        <ProgressBar Height="4" Margin="0,2,0,6" Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource HoverBrush}" BorderThickness="0"
                                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <Grid>
            <StackPanel>
                <TextBlock Text="APP 啟動器" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="從 GitHub 下載、更新和開啟你的 APP。更新後舊版會保留，隨時都能切換回去。"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="開啟 APP 存放資料夾"
                        Command="{Binding OpenAppsFolderCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" ToolTip="向 GitHub 檢查有沒有新版本">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="檢查更新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 有新版時的提示列 -->
        <Border Grid.Row="1" Background="{StaticResource UpdateSoftBrush}" CornerRadius="8" Padding="14,8" Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource UpdateButton}" Command="{Binding UpdateAllCommand}" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                        <TextBlock Text="全部更新" />
                    </StackPanel>
                </Button>
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource UpdateTextBrush}"
                           VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource UpdateTextBrush}">
                    <Run Text="有" /> <Run Text="{Binding UpdateCount, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="個 APP 有新版本。更新不會刪除舊版，仍可從版本選單開啟舊版。" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 批次操作 -->
        <DockPanel Grid.Row="2" Margin="0,16,0,10">
            <CheckBox IsChecked="{Binding AllSelected}" Content="全選" Margin="17,0,16,0" />
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,0,16,0">
                <Run Text="已選" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" /> <Run Text="個" />
            </TextBlock>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DownloadSelectedCommand}" Margin="0,0,8,0"
                    ToolTip="下載或更新勾選的 APP（已是最新版的會略過）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="下載／更新所選" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Left"
                    ToolTip="刪除勾選 APP 的所有版本（不會刪除程式裡的資料）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="刪除所選" />
                </StackPanel>
            </Button>
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppCard}" />
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="2,8,0,0" />
    </Grid>
</Window>
